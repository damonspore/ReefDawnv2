{% for group in robots.default_groups %}
	{{- group.user_agent -}}

	{% for rule in group.rules %}
		{{- rule -}}
	{% endfor %}

	{%- if group.user_agent.value == '*' -%}
	{%- endif -%}

	{%- if group.user_agent.value == 'GPTBot' -%}
		{{- 'Disallow: /admin' }}
		{{- 'Disallow: /cart' }}
		{{- 'Disallow: /orders' }}
		{{- 'Disallow: /checkouts/' }}
		{{- 'Disallow: /checkout' }}
		{{- 'Disallow: /carts' }}
		{{- 'Disallow: /account' }}
		{{- 'Disallow: /search' }}
		{{- 'Disallow: /policies/' }}
		{{- 'Disallow: /*/policies/' }}
	{%- endif -%}

	{%- if group.user_agent.value == 'Google-Extended' -%}
		{{- 'Disallow: /admin' }}
		{{- 'Disallow: /cart' }}
		{{- 'Disallow: /orders' }}
		{{- 'Disallow: /checkouts/' }}
		{{- 'Disallow: /checkout' }}
		{{- 'Disallow: /carts' }}
		{{- 'Disallow: /account' }}
	{%- endif -%}

	{%- if group.user_agent.value == 'PerplexityBot' -%}
		{{- 'Disallow: /admin' }}
		{{- 'Disallow: /cart' }}
		{{- 'Disallow: /orders' }}
		{{- 'Disallow: /checkouts/' }}
		{{- 'Disallow: /carts' }}
		{{- 'Disallow: /account' }}
		{{- 'Disallow: /search' }}
	{%- endif -%}

	{%- if group.user_agent.value == 'Applebot-Extended' -%}
		{{- 'Disallow: /admin' }}
		{{- 'Disallow: /cart' }}
		{{- 'Disallow: /orders' }}
		{{- 'Disallow: /checkouts/' }}
		{{- 'Disallow: /checkout' }}
		{{- 'Disallow: /carts' }}
		{{- 'Disallow: /account' }}
	{%- endif -%}

	{%- if group.sitemap != blank -%}
		{{ group.sitemap }}
		{{- 'Sitemap: https://www.reeftel.com/apps/seo-sitemaps/1dedf0/articles-sitemap.xml' }}
		{{- 'Sitemap: https://www.reeftel.com/apps/seo-sitemaps/1dedf0/pages-sitemap.xml' }}
	{%- endif -%}
{% endfor %}
