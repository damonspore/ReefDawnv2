{% comment %} REEF: Partner / brand logo row — grayscale → color on hover. {% endcomment %}

<div class="reef-logo-bar color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="reef-logo-bar__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="reef-logo-bar__track{% if section.settings.auto_scroll_mobile %} reef-logo-bar__track--marquee{% endif %}">
      <ul class="reef-logo-bar__list" role="list">
        {%- for block in section.blocks -%}
          <li class="reef-logo-bar__item reef-reveal" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="reef-logo-bar__link" aria-label="{{ block.settings.alt | default: 'Partner logo' | escape }}">
              {%- endif -%}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  class: 'reef-logo-bar__img',
                  widths: '200, 300, 400',
                  sizes: '(min-width: 990px) 160px, 120px',
                  alt: block.settings.alt | default: 'Logo'
              }}
              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            {%- else -%}
              <div class="reef-logo-bar__placeholder"></div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Reef — Logo bar",
  "tag": "section",
  "class": "reef-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brands we carry"
    },
    {
      "type": "checkbox",
      "id": "auto_scroll_mobile",
      "label": "Auto-scroll on mobile",
      "default": false,
      "info": "Gentle horizontal motion; disabled when reduced motion is on."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reef — Logo bar",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
