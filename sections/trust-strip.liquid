{%- style -%}
  .trust-strip {
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .trust-strip {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
  .trust-strip__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.5rem 3rem;
  }
  .trust-strip__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .trust-strip__icon {
    font-size: 1.6rem;
    line-height: 1;
  }
  .trust-strip__detail {
    font-weight: 400;
    font-size: 1.1rem;
    opacity: 0.8;
  }
  @media screen and (max-width: 749px) {
    .trust-strip__inner {
      gap: 1rem 2rem;
    }
    .trust-strip__item {
      font-size: 1.1rem;
    }
  }
{%- endstyle -%}

<div class="trust-strip color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="trust-strip__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- for block in section.blocks -%}
        <div class="trust-strip__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="trust-strip__icon">{{ block.settings.icon }}</span>
          {%- endif -%}
          <span>
            {{ block.settings.label }}
            {%- if block.settings.detail != blank -%}
              <span class="trust-strip__detail">{{ block.settings.detail }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "accent-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "\uD83D\uDEE1\uFE0F"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Trust item"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail text (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "\uD83D\uDEE1\uFE0F",
            "label": "10-Year Warranty"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "\uD83D\uDE9A",
            "label": "Free Shipping $300+"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "\u2B50",
            "label": "Trustpilot 4.6/5",
            "detail": "(924 Reviews)"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "\uD83D\uDD12",
            "label": "Secure Checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
