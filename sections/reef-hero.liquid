{% comment %}
  REEF: Full-viewport hero — gradient, headline, dual CTAs, optional media, trust strip.
{% endcomment %}

{%- liquid
  assign fetch_priority = 'high'
  if section.index > 1
    assign fetch_priority = 'auto'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .reef-hero {
    --reef-hero-g1: {{ section.settings.gradient_color_1 }};
    --reef-hero-g2: {{ section.settings.gradient_color_2 }};
    --reef-hero-g3: {{ section.settings.gradient_color_3 }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="reef-hero{% if section.settings.enable_gradient_shift %} reef-hero--animated{% endif %} color-{{ section.settings.color_scheme }}"
  id="section-{{ section.id }}"
>
  <div class="reef-hero__inner page-width">
    <div class="reef-hero__grid{% if section.settings.image != blank %} reef-hero__grid--split{% endif %}">
      <div class="reef-hero__copy reef-reveal">
        {%- if section.settings.heading != blank -%}
          <h1 class="reef-hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="reef-hero__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <div class="reef-hero__actions">
          {%- if section.settings.button_primary_label != blank -%}
            <a
              href="{{ section.settings.button_primary_link }}"
              class="button button--primary reef-hero__btn reef-hero__btn--primary"
            >
              {{- section.settings.button_primary_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_secondary_label != blank -%}
            <a
              href="{{ section.settings.button_secondary_link }}"
              class="button button--secondary reef-hero__btn reef-hero__btn--secondary"
            >
              {{- section.settings.button_secondary_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.image != blank -%}
        <div class="reef-hero__media reef-reveal" aria-hidden="false">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: fetch_priority,
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 45vw, 100vw',
              class: 'reef-hero__img'
          }}
        </div>
      {%- endif -%}
    </div>
    {%- liquid
      assign trust_count = 0
      if section.settings.trust_1 != blank
        assign trust_count = trust_count | plus: 1
      endif
      if section.settings.trust_2 != blank
        assign trust_count = trust_count | plus: 1
      endif
      if section.settings.trust_3 != blank
        assign trust_count = trust_count | plus: 1
      endif
      if section.settings.trust_4 != blank
        assign trust_count = trust_count | plus: 1
      endif
    -%}
    {%- if trust_count > 0 -%}
      <ul class="reef-hero__trust" role="list">
        {%- if section.settings.trust_1 != blank -%}
          <li class="reef-hero__trust-item">{{ section.settings.trust_1 | escape }}</li>
        {%- endif -%}
        {%- if section.settings.trust_2 != blank -%}
          <li class="reef-hero__trust-item">{{ section.settings.trust_2 | escape }}</li>
        {%- endif -%}
        {%- if section.settings.trust_3 != blank -%}
          <li class="reef-hero__trust-item">{{ section.settings.trust_3 | escape }}</li>
        {%- endif -%}
        {%- if section.settings.trust_4 != blank -%}
          <li class="reef-hero__trust-item">{{ section.settings.trust_4 | escape }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reef — Hero",
  "tag": "section",
  "class": "reef-section reef-section--hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "inverse"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Enterprise Hardware. Ocean-Sized Mission."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Refurbished and new telecom, networking, and AI hardware for business — with a commitment to e-waste reduction and ocean conservation."
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Primary button label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Secondary button label",
      "default": "Our mission"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Optional hero image",
      "info": "Leave empty for text-only hero. Use abstract or product imagery — avoid literal cartoon ocean stock."
    },
    {
      "type": "header",
      "content": "Background gradient"
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient top",
      "default": "#0B1A2E"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient mid",
      "default": "#112240"
    },
    {
      "type": "color",
      "id": "gradient_color_3",
      "label": "Gradient accent",
      "default": "#1E3A5F"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_shift",
      "label": "Subtle animated gradient",
      "default": true,
      "info": "Very slow CSS animation; respects reduced motion."
    },
    {
      "type": "header",
      "content": "Trust strip"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust line 1",
      "default": "Trusted by 2,000+ businesses"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust line 2",
      "default": "30-day returns"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust line 3",
      "default": "Certified refurbished"
    },
    {
      "type": "text",
      "id": "trust_4",
      "label": "Trust line 4",
      "default": "Fast shipping"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Reef — Hero"
    }
  ]
}
{% endschema %}
