
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ElectronicsStore",
  "url": {{ request.origin | json }},
  "name": {{ shop.name | json }},
  "description": {{ shop.description | json }},
  "image": "{{ settings.logo | image_url: width: 600 }}",
  "email": {{ shop.email | json }},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1107 Saint Andrews Rd.",
    "addressLocality": "Hollywood",
    "addressRegion": "FL",
    "postalCode": "33021",
    "addressCountry": "US"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "09:00",
    "closes": "18:00"
  },
  {%- assign local_same_as = '' -%}
  {%- if settings.social_facebook_link != blank -%}
    {%- assign local_same_as = local_same_as | append: settings.social_facebook_link | append: '||' -%}
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
    {%- assign local_same_as = local_same_as | append: settings.social_instagram_link | append: '||' -%}
  {%- endif -%}
  {%- if local_same_as != blank -%}
    {%- assign local_same_as_arr = local_same_as | split: '||' -%}
    "sameAs": [
      {%- for link in local_same_as_arr -%}
        {%- unless link == blank -%}{{ link | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endunless -%}
      {%- endfor -%}
    ],
  {%- endif -%}
  "telephone": {{ shop.phone | default: '+18882173331' | json }},
  "priceRange": "$$"
}
</script>
{%- endif -%}
