{%- unless request.page_type == 'index' -%}
  {%- style -%}
    .breadcrumbs {
      padding: 1.2rem 0 0;
      font-size: 1.3rem;
      line-height: 1.4;
    }
    .breadcrumbs__list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.3rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .breadcrumbs__separator {
      color: rgba(var(--color-foreground), 0.4);
      user-select: none;
    }
    .breadcrumbs a {
      color: rgba(var(--color-foreground), 0.6);
      text-decoration: none;
    }
    .breadcrumbs a:hover {
      color: rgb(var(--color-foreground));
      text-decoration: underline;
    }
    .breadcrumbs [aria-current] {
      color: rgba(var(--color-foreground), 0.8);
    }
  {%- endstyle -%}

  {%- liquid
    assign origin = request.origin
    assign crumbs = ''
  -%}

  {%- liquid
    if request.page_type == 'product'
      assign breadcrumb_collection = collection | default: product.collections.first
    endif
  -%}

  <nav class="breadcrumbs page-width" aria-label="Breadcrumb">
    {%- if request.page_type == 'product' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ origin | json }}
          }
          {%- if breadcrumb_collection -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ breadcrumb_collection.title | json }},
              "item": {{ origin | append: breadcrumb_collection.url | json }}
            }
            ,{
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }}
            }
          {%- else -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }}
            }
          {%- endif -%}
        ]
      }
      </script>
      <ol class="breadcrumbs__list" role="list">
        <li><a href="/">Home</a></li>
        {%- if breadcrumb_collection -%}
          <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
          <li><a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title | escape }}</a></li>
        {%- endif -%}
        <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
        <li><span aria-current="page">{{ product.title | escape }}</span></li>
      </ol>

    {%- elsif request.page_type == 'collection' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ origin | json }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }}
          }
        ]
      }
      </script>
      <ol class="breadcrumbs__list" role="list">
        <li><a href="/">Home</a></li>
        <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
        <li><span aria-current="page">{{ collection.title | escape }}</span></li>
      </ol>

    {%- elsif request.page_type == 'article' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ origin | json }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ origin | append: blog.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | json }}
          }
        ]
      }
      </script>
      <ol class="breadcrumbs__list" role="list">
        <li><a href="/">Home</a></li>
        <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
        <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
        <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
        <li><span aria-current="page">{{ article.title | escape }}</span></li>
      </ol>

    {%- elsif request.page_type == 'blog' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ origin | json }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }}
          }
        ]
      }
      </script>
      <ol class="breadcrumbs__list" role="list">
        <li><a href="/">Home</a></li>
        <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
        <li><span aria-current="page">{{ blog.title | escape }}</span></li>
      </ol>

    {%- elsif request.page_type == 'page' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ origin | json }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }}
          }
        ]
      }
      </script>
      <ol class="breadcrumbs__list" role="list">
        <li><a href="/">Home</a></li>
        <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
        <li><span aria-current="page">{{ page.title | escape }}</span></li>
      </ol>

    {%- elsif request.page_type == 'search' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ origin | json }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ 'templates.search.title' | t | json }}
          }
        ]
      }
      </script>
      <ol class="breadcrumbs__list" role="list">
        <li><a href="/">Home</a></li>
        <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
        <li><span aria-current="page">{{ 'templates.search.title' | t | escape }}</span></li>
      </ol>

    {%- elsif request.page_type == 'list-collections' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ origin | json }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Collections"
          }
        ]
      }
      </script>
      <ol class="breadcrumbs__list" role="list">
        <li><a href="/">Home</a></li>
        <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
        <li><span aria-current="page">Collections</span></li>
      </ol>

    {%- elsif request.page_type == 'cart' -%}
      <ol class="breadcrumbs__list" role="list">
        <li><a href="/">Home</a></li>
        <li><span class="breadcrumbs__separator" aria-hidden="true">/</span></li>
        <li><span aria-current="page">{{ 'sections.cart.title' | t | escape }}</span></li>
      </ol>
    {%- endif -%}
  </nav>
{%- endunless -%}
